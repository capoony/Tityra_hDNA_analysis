import sys
from collections import defaultdict

sequences = defaultdict(list)

# Read sequences
with open("${FILE}") as f:
    header = None
    seq = []
    for line in f:
        line = line.strip()
        if line.startswith(">"):
            if header:
                sequences[species].append((header, ''.join(seq)))
            header = line
            # Extract species name (first two words of header)
            parts = line.replace(">", "").split()
            species = "_".join(parts[:2]) if len(parts) >= 2 else parts[0]
            seq = []
        else:
            seq.append(line)
    if header:
        sequences[species].append((header, ''.join(seq)))

# Write up to 3 samples per species
output_file = "${OUTPUT_FILE}"
count = 0
with open(output_file, 'a') as out:
    for species, seqs in sequences.items():
        for i, (header, seq) in enumerate(seqs[:3]):  # Limit to 3
            out.write(f"{header}\n{seq}\n")
            count += 1

print(f"  Added {count} sequences from ${GENUS}")
PYTHON_EOF
